# Template only. Create .env.deploy on the deployment host; never commit real values.
# Production refuses to start without HTTPS origin and a >=32-character access token.
APP_ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=https://replace-with-your-domain.example
DEPLOY_ACCESS_TOKEN=
RECORD_STORAGE=sqlite
RECORD_DATA_DIR=/app/web-voice-agent/data

# T selected per=4100. Fill credentials on the deployment host to enable speech.
ASR_PROVIDER=baidu
TTS_PROVIDER=baidu
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ASR_DEV_PID=1537
BAIDU_TTS_SERVICE=short_text
BAIDU_TTS_VOICE=4100
BAIDU_TTS_VOICE_NAME=度小雯（per 4100）

# Optional read-only semantic routing; disabled until a model is explicitly configured.
SEMANTIC_PROVIDER=none
SEMANTIC_API_KEY=
SEMANTIC_MODEL=
