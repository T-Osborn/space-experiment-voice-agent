# 选择 baidu、generic_http 或 openai；不要把真实密钥提交到仓库。
ASR_PROVIDER=baidu

# sqlite saves task state across restarts; memory is for disposable tests only.
RECORD_STORAGE=sqlite
# Blank uses web-voice-agent/data. Keep this directory on persistent local storage.
RECORD_DATA_DIR=

# 百度语音应用（AK/SK方式），T于2026-10-15为2.0选择per=5度小娇。
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ASR_DEV_PID=1537
# short_text=普通/精品音色；clone=大模型声音复刻，需要已开通的voice_id。
BAIDU_TTS_SERVICE=short_text
BAIDU_TTS_VOICE=5
BAIDU_TTS_VOICE_NAME=度小娇（per 5）
BAIDU_TTS_SPEED=5
BAIDU_TTS_PITCH=5
BAIDU_TTS_VOLUME=5

# OpenAI ASR 适配器
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
ASR_TIMEOUT_MS=15000

# 服务端 TTS 适配器；失败时不更换所选音色。显式 TTS_PROVIDER=browser 才使用浏览器音色。
TTS_PROVIDER=baidu
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
OPENAI_TTS_SPEED=0.95
TTS_TIMEOUT_MS=15000

# generic_http 适配器（改用 generic_http 时填写）
ASR_UPSTREAM_URL=
ASR_API_KEY=

# generic_http TTS（改用 generic_http 时填写）
TTS_UPSTREAM_URL=
TTS_API_KEY=
TTS_VOICE=

# 可选：只读知识问题匹配。暂缓配置时保持 none；不复用语音密钥。
# 开启会把问题及公开条目目录发给模型服务，不能生成操作/参数/步骤确认。
SEMANTIC_PROVIDER=none
SEMANTIC_API_KEY=
# 显式选择支持 Responses Structured Outputs 的模型后填写，不预设模型。
SEMANTIC_MODEL=
